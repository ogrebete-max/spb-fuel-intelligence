# Caddy in front of the club server. install.sh writes this file to
# /etc/caddy/Caddyfile with @IP@ replaced by the server's address.
#
# There is no domain: phones reach the club by the bare IP address. Let's
# Encrypt certifies a bare IP only under its short-lived profile, about six
# days, and Caddy renews such a certificate by itself well before it expires.
{
	servers {
		# HTTP/1.1 and HTTP/2 only. QUIC (HTTP/3 over UDP) is often blocked on
		# Russian networks, and a phone trying it first would only wait.
		protocols h1 h2
	}
}

http://@IP@ {
	redir https://@IP@{uri} 308
}

https://@IP@ {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	# The app sends small JSON; a body this large is not from it.
	request_body {
		max_size 1MB
	}
	encode gzip

	# The Ladoga fishing map (github.com/ogrebete-max/ladoga-fishing-map): a
	# static site under /ladoga/, uploaded by that repository's
	# scripts/deploy_vps.sh into /var/www/ladoga/current. Tiles never change
	# under the same name; the page, the service worker and the data must be
	# checked on every visit.
	redir /ladoga /ladoga/ 308
	# Work log of the owner's apps (ladoga-logs.service, scripts/logs in ladoga-fishing-map):
	# the Ladoga map, and under /applog/<app>/ any other app (СПб Топливо: /applog/fuel/log).
	handle /ladoga/api/* {
		reverse_proxy 127.0.0.1:8791
	}
	handle /applog/* {
		reverse_proxy 127.0.0.1:8791
	}
	handle_path /ladoga/* {
		root * /var/www/ladoga/current
		@lasting path /tiles/* /overlays/* /vendor/* /icons/*
		header @lasting Cache-Control "public, max-age=2592000"
		@fresh path / /index.html /sw.js /manifest.webmanifest /data/* /*.js /*.css
		header @fresh Cache-Control "no-cache"
		file_server
	}

	# «Ау» — лесной навигатор (C:\STT\au-les, scripts/deploy_vps.sh): a static site under /les/.
	# Overpass for «Ау» (roads, bogs, power lines around a person): the public servers turn browsers away (an
	# Origin header gets a 504 from Mail.ru, the others send no CORS header); asked from here, Mail.ru answers.
	handle /les/api/overpass {
		rewrite * /osm/tools/overpass/api/interpreter
		reverse_proxy https://maps.mail.ru {
			header_up Host maps.mail.ru
			header_up -Origin
			header_up -Referer
			header_up -Cookie
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# The second way for «Ау»: overpass-api.de, asked from here with a User-Agent of its own.
	handle /les/api/overpass2 {
		rewrite * /api/interpreter
		reverse_proxy https://overpass-api.de {
			header_up Host overpass-api.de
			header_up User-Agent "au-les/1.0 (+https://195.133.61.136/les/)"
			header_up -Origin
			header_up -Referer
			header_up -Cookie
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# «Ау» — поход для близких (C:\STT\au-les\server\trip_server.py, au-trip.service): the points of a trip go to the
	# service; /les/trip/<id> is trip.html of the live release. Never cached; the link goes no further as a Referer.
	handle /les/api/trip/* {
		reverse_proxy 127.0.0.1:8792
	}
	handle /les/trip/* {
		root * /var/www/les/current
		rewrite * /trip.html
		header Cache-Control "no-store"
		header Referrer-Policy "strict-origin"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	# «Ау» — общий поход (C:\STT\au-les\server\trip_server.py, au-trip.service): the places of a group of 2–8 people.
	handle /les/api/group/* {
		reverse_proxy 127.0.0.1:8792
	}

	redir /les /les/ 308
	handle_path /les/* {
		root * /var/www/les/current
		@lasting path /vendor/* /icons/*
		header @lasting Cache-Control "public, max-age=2592000"
		@fresh path / /index.html /sw.js /manifest.webmanifest /*.js
		header @fresh Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8787 {
			# The address Caddy saw. server/http.mjs takes the last entry of this
			# header as the visitor, so it must be Caddy's own.
			header_up X-Forwarded-For {remote_host}
			# The club server holds an idle connection for 35 s. Caddy lets go
			# after 30, so it never sends a request down one being closed.
			transport http {
				keepalive 30s
			}
		}
	}
}
